generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model couples {
  id                             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_a_id                      String     @db.Uuid
  user_b_id                      String?    @db.Uuid
  pair_code                      String     @unique @db.VarChar(8)
  pair_status                    String?    @default("pending")
  paired_at                      DateTime?  @db.Timestamptz(6)
  created_at                     DateTime?  @default(now()) @db.Timestamptz(6)
  users_couples_user_a_idTousers users      @relation("couples_user_a_idTousers", fields: [user_a_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_couples_user_b_idTousers users?     @relation("couples_user_b_idTousers", fields: [user_b_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events                         events[]
  routines                       routines[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                               String         @id @db.Uuid
  email                            String         @unique @db.VarChar(255)
  display_name                     String         @db.VarChar(100)
  avatar_url                       String?
  couple_id                        String?        @db.Uuid
  fcm_token                        String?
  timezone                         String?        @default("Asia/Jakarta") @db.VarChar(50)
  currency                         String?        @default("IDR") @db.VarChar(3)
  created_at                       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime?      @default(now()) @db.Timestamptz(6)
  couples_couples_user_a_idTousers couples[]      @relation("couples_user_a_idTousers")
  couples_couples_user_b_idTousers couples[]      @relation("couples_user_b_idTousers")
  events                           events[]
  routines                         routines[]
  routine_logs                     routine_logs[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couple_id    String    @db.Uuid
  created_by   String    @db.Uuid
  title        String    @db.VarChar(200)
  description  String?
  start_at     DateTime  @db.Timestamptz(6)
  end_at       DateTime? @db.Timestamptz(6)
  all_day      Boolean?  @default(false)
  category     String?
  visibility   String?   @default("both")
  color        String?   @db.VarChar(7)
  is_recurring Boolean?  @default(false)
  recur_rule   Json?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  couples      couples   @relation(fields: [couple_id], references: [id], onDelete: Cascade)
  users        users     @relation(fields: [created_by], references: [id])

  @@index([couple_id, start_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routines {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couple_id     String         @db.Uuid
  user_id       String?        @db.Uuid
  title         String         @db.VarChar(200)
  icon          String?        @db.VarChar(50)
  category      String?        @db.VarChar(50)
  time_of_day   String?
  reminder_time DateTime?      @db.Time(6)
  is_shared     Boolean?       @default(false)
  is_active     Boolean?       @default(true)
  sort_order    Int?            @default(0)
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @default(now()) @db.Timestamptz(6)
  couples       couples        @relation(fields: [couple_id], references: [id], onDelete: Cascade)
  users         users?         @relation(fields: [user_id], references: [id])
  routine_logs  routine_logs[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routine_logs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id   String    @db.Uuid
  user_id      String    @db.Uuid
  log_date     DateTime  @db.Date
  completed_at DateTime? @db.Timestamptz(6)
  notes        String?
  routines     routines  @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  users        users     @relation(fields: [user_id], references: [id])

  @@unique([routine_id, user_id, log_date])
  @@index([user_id, log_date])
}
